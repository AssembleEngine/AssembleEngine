digraph frame_graph {
  rankdir=LR;
  node [shape=box, style=filled];
  p4 [label="0: units reset\nTransfer", fillcolor="#fff3cd"];
  p5 [label="1: units cull\nCompute", fillcolor="#d1e7dd"];
  p7 [label="2: units count\nTransfer", fillcolor="#fff3cd"];
  p8 [label="3: units count read\nTransfer", fillcolor="#fff3cd"];
  p1 [label="4: units pose\nCompute", fillcolor="#d1e7dd"];
  p2 [label="5: shadows\nGraphics", fillcolor="#cfe2ff"];
  p0 [label="6: terrain lod\nCompute", fillcolor="#d1e7dd"];
  p3 [label="7: terrain\nGraphics", fillcolor="#cfe2ff"];
  p6 [label="8: units\nGraphics", fillcolor="#cfe2ff"];
  p9 [label="9: water\nGraphics", fillcolor="#cfe2ff"];
  p10 [label="10: copy\nTransfer", fillcolor="#fff3cd"];
  p11 [label="11: host read\nTransfer", fillcolor="#fff3cd"];
  p0 -> p3 [label="terrain.leaves"];
  p0 -> p3 [label="terrain.indirect"];
  p1 -> p2 [label="units.palette"];
  p1 -> p6 [label="units.palette"];
  p2 -> p3 [label="shadows.map"];
  p2 -> p6 [label="shadows.map"];
  p2 -> p9 [label="shadows.map"];
  p3 -> p6 [label="depth"];
  p3 -> p6 [label="readback.target"];
  p4 -> p5 [label="units.indirect"];
  p5 -> p6 [label="units.visible"];
  p5 -> p6 [label="units.indirect"];
  p5 -> p7 [label="units.indirect"];
  p6 -> p9 [label="depth"];
  p6 -> p9 [label="readback.target"];
  p7 -> p8 [label="units.counts"];
  p9 -> p10 [label="readback.target"];
  p10 -> p11 [label="readback.buffer"];
  // physical 0 Transient: depth
}
