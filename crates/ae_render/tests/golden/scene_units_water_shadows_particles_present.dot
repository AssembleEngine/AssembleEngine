digraph frame_graph {
  rankdir=LR;
  node [shape=box, style=filled];
  p2 [label="0: units reset\nTransfer", fillcolor="#fff3cd"];
  p1 [label="1: units pose\nCompute", fillcolor="#d1e7dd"];
  p0 [label="2: terrain lod\nCompute", fillcolor="#d1e7dd"];
  p3 [label="3: units cull\nCompute", fillcolor="#d1e7dd"];
  p8 [label="4: units count\nTransfer", fillcolor="#fff3cd"];
  p9 [label="5: units count read\nTransfer", fillcolor="#fff3cd"];
  p4 [label="6: shadows\nGraphics", fillcolor="#cfe2ff"];
  p11 [label="7: particles sim\nCompute", fillcolor="#d1e7dd"];
  p5 [label="8: particle shadows\nGraphics", fillcolor="#cfe2ff"];
  p6 [label="9: terrain\nGraphics", fillcolor="#cfe2ff"];
  p7 [label="10: units\nGraphics", fillcolor="#cfe2ff"];
  p10 [label="11: water\nGraphics", fillcolor="#cfe2ff"];
  p12 [label="12: particles\nGraphics", fillcolor="#cfe2ff"];
  p13 [label="13: tonemap\nGraphics", fillcolor="#cfe2ff"];
  p14 [label="14: present\nPresent", fillcolor="#e2e3e5"];
  p0 -> p6 [label="terrain.leaves"];
  p0 -> p6 [label="terrain.indirect"];
  p1 -> p4 [label="units.palette"];
  p1 -> p7 [label="units.palette"];
  p2 -> p3 [label="units.indirect"];
  p3 -> p4 [label="units.visible"];
  p3 -> p4 [label="units.indirect"];
  p3 -> p7 [label="units.visible"];
  p3 -> p7 [label="units.indirect"];
  p3 -> p8 [label="units.indirect"];
  p4 -> p6 [label="shadows.map"];
  p4 -> p7 [label="shadows.map"];
  p4 -> p10 [label="shadows.map"];
  p5 -> p6 [label="shadows.color"];
  p5 -> p7 [label="shadows.color"];
  p5 -> p10 [label="shadows.color"];
  p6 -> p7 [label="depth"];
  p6 -> p7 [label="scene"];
  p7 -> p10 [label="depth"];
  p7 -> p10 [label="scene"];
  p7 -> p12 [label="depth"];
  p8 -> p9 [label="units.counts"];
  p10 -> p12 [label="scene"];
  p11 -> p5 [label="particles.state"];
  p11 -> p5 [label="particles.keys"];
  p11 -> p5 [label="particles.indirect"];
  p11 -> p12 [label="particles.state"];
  p11 -> p12 [label="particles.keys"];
  p11 -> p12 [label="particles.indirect"];
  p12 -> p13 [label="scene"];
  p13 -> p14 [label="target"];
  // physical 0 Transient: depth
  // physical 1 Transient: scene
}
