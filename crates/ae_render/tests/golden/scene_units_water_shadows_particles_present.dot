digraph frame_graph {
  rankdir=LR;
  node [shape=box, style=filled];
  p4 [label="0: units reset\nTransfer", fillcolor="#fff3cd"];
  p5 [label="1: units cull\nCompute", fillcolor="#d1e7dd"];
  p7 [label="2: units count\nTransfer", fillcolor="#fff3cd"];
  p8 [label="3: units count read\nTransfer", fillcolor="#fff3cd"];
  p0 [label="4: terrain lod\nCompute", fillcolor="#d1e7dd"];
  p1 [label="5: shadows\nGraphics", fillcolor="#cfe2ff"];
  p10 [label="6: particles sim\nCompute", fillcolor="#d1e7dd"];
  p2 [label="7: particle shadows\nGraphics", fillcolor="#cfe2ff"];
  p3 [label="8: terrain\nGraphics", fillcolor="#cfe2ff"];
  p6 [label="9: units\nGraphics", fillcolor="#cfe2ff"];
  p9 [label="10: water\nGraphics", fillcolor="#cfe2ff"];
  p11 [label="11: particles\nGraphics", fillcolor="#cfe2ff"];
  p12 [label="12: present\nPresent", fillcolor="#e2e3e5"];
  p0 -> p3 [label="terrain.leaves"];
  p0 -> p3 [label="terrain.indirect"];
  p1 -> p3 [label="shadows.map"];
  p1 -> p6 [label="shadows.map"];
  p1 -> p9 [label="shadows.map"];
  p2 -> p3 [label="shadows.color"];
  p2 -> p6 [label="shadows.color"];
  p2 -> p9 [label="shadows.color"];
  p3 -> p6 [label="depth"];
  p3 -> p6 [label="target"];
  p4 -> p5 [label="units.indirect"];
  p5 -> p6 [label="units.visible"];
  p5 -> p6 [label="units.indirect"];
  p5 -> p7 [label="units.indirect"];
  p6 -> p9 [label="depth"];
  p6 -> p9 [label="target"];
  p6 -> p11 [label="depth"];
  p7 -> p8 [label="units.counts"];
  p9 -> p11 [label="target"];
  p10 -> p2 [label="particles.state"];
  p10 -> p2 [label="particles.keys"];
  p10 -> p2 [label="particles.indirect"];
  p10 -> p11 [label="particles.state"];
  p10 -> p11 [label="particles.keys"];
  p10 -> p11 [label="particles.indirect"];
  p11 -> p12 [label="target"];
  // physical 0 Transient: depth
}
