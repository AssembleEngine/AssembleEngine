digraph frame_graph {
  rankdir=LR;
  node [shape=box, style=filled];
  p2 [label="0: units reset\nTransfer", fillcolor="#fff3cd"];
  p1 [label="1: units pose\nCompute", fillcolor="#d1e7dd"];
  p3 [label="2: units cull\nCompute", fillcolor="#d1e7dd"];
  p7 [label="3: units count\nTransfer", fillcolor="#fff3cd"];
  p8 [label="4: units count read\nTransfer", fillcolor="#fff3cd"];
  p0 [label="5: terrain lod\nCompute", fillcolor="#d1e7dd"];
  p4 [label="6: lights\nCompute", fillcolor="#d1e7dd"];
  p5 [label="7: terrain\nGraphics", fillcolor="#cfe2ff"];
  p6 [label="8: units\nGraphics", fillcolor="#cfe2ff"];
  p9 [label="9: water\nGraphics", fillcolor="#cfe2ff"];
  p10 [label="10: bloom downsample\nGraphics", fillcolor="#cfe2ff"];
  p11 [label="11: bloom blur x\nGraphics", fillcolor="#cfe2ff"];
  p12 [label="12: bloom blur y\nGraphics", fillcolor="#cfe2ff"];
  p13 [label="13: tonemap\nGraphics", fillcolor="#cfe2ff"];
  p14 [label="14: present\nPresent", fillcolor="#e2e3e5"];
  p0 -> p5 [label="terrain.leaves"];
  p0 -> p5 [label="terrain.indirect"];
  p1 -> p6 [label="units.palette"];
  p2 -> p3 [label="units.indirect"];
  p3 -> p6 [label="units.visible"];
  p3 -> p6 [label="units.indirect"];
  p3 -> p7 [label="units.indirect"];
  p4 -> p5 [label="lights.list"];
  p4 -> p5 [label="lights.clusters"];
  p4 -> p6 [label="lights.list"];
  p4 -> p6 [label="lights.clusters"];
  p4 -> p9 [label="lights.list"];
  p4 -> p9 [label="lights.clusters"];
  p5 -> p6 [label="depth"];
  p5 -> p6 [label="scene"];
  p5 -> p6 [label="glow"];
  p6 -> p9 [label="depth"];
  p6 -> p9 [label="scene"];
  p6 -> p9 [label="glow"];
  p7 -> p8 [label="units.counts"];
  p9 -> p10 [label="glow"];
  p9 -> p13 [label="scene"];
  p10 -> p11 [label="bloom.0"];
  p10 -> p12 [label="bloom.0"];
  p11 -> p12 [label="bloom.0"];
  p11 -> p12 [label="bloom.1"];
  p12 -> p13 [label="bloom.0"];
  p13 -> p14 [label="target"];
