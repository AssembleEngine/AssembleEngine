digraph frame_graph {
  rankdir=LR;
  node [shape=box, style=filled];
  p3 [label="0: units reset\nTransfer", fillcolor="#fff3cd"];
  p1 [label="1: units pose\nCompute", fillcolor="#d1e7dd"];
  p4 [label="2: units cull\nCompute", fillcolor="#d1e7dd"];
  p6 [label="3: units count\nTransfer", fillcolor="#fff3cd"];
  p7 [label="4: units count read\nTransfer", fillcolor="#fff3cd"];
  p0 [label="5: terrain lod\nCompute", fillcolor="#d1e7dd"];
  p2 [label="6: terrain\nGraphics", fillcolor="#cfe2ff"];
  p5 [label="7: units\nGraphics", fillcolor="#cfe2ff"];
  p8 [label="8: copy\nTransfer", fillcolor="#fff3cd"];
  p9 [label="9: host read\nTransfer", fillcolor="#fff3cd"];
  p0 -> p2 [label="terrain.leaves"];
  p0 -> p2 [label="terrain.indirect"];
  p1 -> p5 [label="units.palette"];
  p2 -> p5 [label="depth"];
  p2 -> p5 [label="readback.target"];
  p3 -> p4 [label="units.indirect"];
  p4 -> p5 [label="units.visible"];
  p4 -> p5 [label="units.indirect"];
  p4 -> p6 [label="units.indirect"];
  p5 -> p8 [label="readback.target"];
  p6 -> p7 [label="units.counts"];
  p8 -> p9 [label="readback.buffer"];
  // physical 0 Transient: depth
}
