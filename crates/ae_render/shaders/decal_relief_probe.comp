#version 460
// Correctness probe for the production fragment tracer.
layout(local_size_x = 64) in;

struct Ray {
    vec4 line;
    vec4 params;
};
layout(std430, set = 0, binding = 0) readonly buffer Rays { Ray rays[]; };
layout(std430, set = 0, binding = 1) writeonly buffer Hits { vec4 hits[]; };
layout(set = 0, binding = 2) uniform sampler2DArray decalSurface;
layout(set = 0, binding = 3) uniform sampler2DArray decalCones;
layout(push_constant) uniform ProbeParams { uint count; uint coneSteps; uint refineSteps; } p;
#include "decal_relief.glsl"

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.count) return;
    Ray r = rays[i];
    ReliefHit hit = reliefTrace(ReliefRay(r.line.xy, r.line.zw, r.params.xy, r.params.z),
                                int(r.params.w), p.coneSteps, p.refineSteps);
    hits[i] = vec4(hit.uv, hit.heightWorld, hit.valid ? float(hit.steps) : -1.0 - float(hit.steps));
}
