#version 460
// One invocation per pool slot: age and move a live particle, and append
// its sort key when it is in view (and, with flags.z, its slot to the
// coloured shadows' casters when it is not emissive, in view or not). Key: far-to-near depth (16 bits, log
// scale from the near plane) above the slot (16 bits): unique, so the
// sorted order does not depend on the order of the appends.
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_basic : require
#define PARTICLES_WRITE
#include "particles_common.glsl"
#include "lights.glsl"

layout(local_size_x = 64) in;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= u.pool.x) {
        return;
    }
    Particle p = particles[i];
    if (p.posAge.w >= p.velLife.w) {
        return;
    }
    float dt = u.step.x;
    uint e = p.info.x * 6u;
    vec4 physics = u.effects[e + 4u];
    p.posAge.w += dt;
    vec3 vel = p.velLife.xyz;
    vel.y -= physics.x * dt;
    vel *= exp(-physics.y * dt);
    p.posAge.xyz += vel * dt;
    p.velLife.xyz = vel;
    particles[i] = p;
    if (p.posAge.w >= p.velLife.w) {
        return;
    }
    if (u.flags.z != 0u && physics.z < 0.5) {
        keys[u.pool.x + atomicAdd(cmd.casterCount, 1u)] = i;
    }
    float t = p.posAge.w / p.velLife.w;
    vec4 shape = u.effects[e + 2u];
    float radius = 0.5 * mix(shape.x, shape.y, t) * uintBitsToFloat(p.info.z);
    bool visible = true;
    for (int k = 0; k < 6; ++k) {
        visible = visible && dot(u.frustum[k].xyz, p.posAge.xyz) + u.frustum[k].w >= -radius;
    }
    float d = dot(p.posAge.xyz - u.camPos.xyz, u.camForward.xyz);
    // A medium in view is lit by the clustered lights once a frame, here
    // (the puff reads it); an emissive particle lights itself.
    if (physics.z < 0.5) {
        // Illuminance times exposure: what the scene stores (the 10-bit
        // packing has its precision where the display does).
        particles[i].info.w = visible && lightsOn() ? packParticleLight(lightsAround(lightClusterAt(u.viewProj, p.posAge.xyz), p.posAge.xyz) * u.photometry.x) : 0u;
    }
    if (visible) {
        float q = clamp(log2(max(d, u.camPos.w) / u.camPos.w) / 24.0, 0.0, 1.0);
        uint key = ((65535u - uint(q * 65535.0)) << 16) | i;
        keys[atomicAdd(cmd.instanceCount, 1u)] = key;
    }
    // The visible depth range (the moments' depth warp, the froxels' slices; flags.y), one
    // atomic per subgroup.
    if (u.flags.y == 0u) {
        return;
    }
    float lo = subgroupMin(visible ? max(d - radius, u.camPos.w) : 3.4e38);
    float hi = subgroupMax(visible ? max(d + radius, u.camPos.w) : 0.0);
    if (subgroupElect()) {
        if (lo < 3.4e38) {
            atomicMin(cmd.depthMin, floatBitsToUint(lo));
        }
        if (hi > 0.0) {
            atomicMax(cmd.depthMax, floatBitsToUint(hi));
        }
    }
}
