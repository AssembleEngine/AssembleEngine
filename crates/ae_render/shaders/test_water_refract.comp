#version 460
#include "bindless.glsl"
#include "water_refraction.glsl"
layout(local_size_x = 1) in;
layout(std430, set = AE_BINDLESS_SET, binding = AE_BUFFERS) buffer Output {
    vec4 offsets;
    vec4 guards;
} outputs[];

void main() {
    vec2 normal = vec2(0.2, -0.4);
    outputs[ae.words.x].offsets = vec4(
        length(refractionOffset(normal, 0.0)), length(refractionOffset(normal, 1.0)),
        length(refractionOffset(normal, 4.0)), length(refractionOffset(normal, 16.0)));
    vec4 bed = vec4(0.35, 0.32, 0.24, 1.0);
    outputs[ae.words.x].guards = vec4(
        refractionGuard(bed, bed),
        refractionGuard(bed, vec4(bed.rgb, 0.75)),
        refractionGuard(bed, vec4(4.0, 2.0, 1.0, 1.0)),
        refractionGuard(bed, vec4(bed.rgb * 1.3, 1.0)));
}
