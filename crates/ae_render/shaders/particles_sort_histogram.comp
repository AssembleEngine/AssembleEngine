#version 460
// Radix sort pass 1: per-workgroup bin counts.
#include "particles_sort.glsl"

shared uint histogram[RADIX_SORT_BINS];

void main() {
    uint lID = gl_LocalInvocationID.x;
    uint wID = gl_WorkGroupID.x;
    uint n = cmd.instanceCount;
    histogram[lID] = 0u;
    barrier();
    for (uint index = 0u; index < BLOCKS_PER_WORKGROUP; index++) {
        // Uniform across the workgroup: no live keys from this block on.
        if ((wID * BLOCKS_PER_WORKGROUP + index) * WORKGROUP_SIZE >= n) {
            break;
        }
        uint elementId = wID * BLOCKS_PER_WORKGROUP * WORKGROUP_SIZE + index * WORKGROUP_SIZE + lID;
        if (elementId < n) {
            uint bin = (keyIn(elementId) >> push.shift) & uint(RADIX_SORT_BINS - 1);
            atomicAdd(histogram[bin], 1u);
        }
    }
    barrier();
    histograms[RADIX_SORT_BINS * wID + lID] = histogram[lID];
}
