#version 460
// Frustum culling of the unit instances: appends the index of every unit
// whose bounding sphere touches the view to the visible list and counts it
// in the indirect draw's instance count (reset to 0 by the pass before;
// with SUB, blips and ghosts in the water overlay's: overlayWord),
// and every row's placement to the end of the list (placeUnit,
// units_common.glsl) for the draws.
// With the reflection's lists bound (mirrorListsBound), the same dispatch
// also fills them: the units_mirror_cull.glsl test, as the MIRROR variant
// (`units.cull_reflect`) does alone.
#define CULL
#include "units_common.glsl"

// How far a floating hull may ride off its flat-water position (the full
// tier's waves, water_patch.glsl WAVE_BOUND): the cull widens its sphere by
// it, so a hull riding a crest at the screen's edge is not culled early.
#include "water_patch.glsl"
#include "units_mirror_cull.glsl"
float rideMargin(Unit unit) {
    return u.height.w > 0.5 && (uint(u.classes[unit.cls].w) & 1u) != 0u ? WAVE_BOUND : 0.0;
}

layout(local_size_x = 64) in;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= u.counts.x) {
        return;
    }
#ifdef MIRROR
    if (!eligible(i)) return;
#endif
    Unit unit = loadUnit(i);
    placeUnit(UNIT_VISIBLE_INDEX, i, unit);
#ifndef MIRROR
    if (mirrorListsBound() && eligible(i)) {
        Unit m = mirrorUnit(unit, i);
        placeUnit(ae.words.z, i, m);
        vec3 c = m.pos + vec3(0.0, 0.4 * m.size, 0.0);
        float mr = 1.6 * m.size + rideMargin(m);
        if (mirrorReachesWater(c, mr) && inMirrorView(c, mr)) {
            mirrorVisible[atomicAdd(mirrorWords[1], 1u)] = i;
        }
    }
#endif
    vec3 centre = unit.pos + vec3(0.0, 0.4 * unit.size, 0.0);
    float r = 1.6 * unit.size + rideMargin(unit);
#ifdef MIRROR
    if (!mirrorReachesWater(centre, r)) return;
#endif
    for (int k = 0; k < 6; k++) {
        if (dot(UNIT_VIEW_PLANES[k].xyz, centre) + UNIT_VIEW_PLANES[k].w < -r) {
            return;
        }
    }
#if defined(SUB) && !defined(MIRROR)
    // Refraction frames: blips and ghosts to the water overlay's list
    // (overlayWord), from the back.
    if (!eligible(i)) {
        visible[u.counts.y - 1u - atomicAdd(cmd.overlay[1], 1u)] = i;
        return;
    }
#endif
    visible[atomicAdd(cmd.instanceCount, 1u)] = i;
}
