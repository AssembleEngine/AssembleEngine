#version 460
// The frame's joint key writes into the key table (units.pose, before the
// poses): one invocation per write (units.rs write_frame stages them from
// UnitFeed::take). The table lives across frames; only what changed comes.
#define POSE
#define KEY_WRITES
#include "units_common.glsl"
#include "units_models.glsl"

layout(local_size_x = 64) in;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= u.anim.z) {
        return;
    }
    uint at = 3u * stagedAt[i];
    keys[at] = staged[3u * i];
    keys[at + 1u] = staged[3u * i + 1u];
    keys[at + 2u] = staged[3u * i + 2u];
}
