#version 460
// The units' poses (units.pose): one invocation per unit with joint keys
// (a pose job, units.rs write_rows). Each bone's local transform is taken
// on the line through its two keys at the drawn tick (ae_model::anim::
// on_line: lerp, nlerp, past the newer key too) into the unit's scratch
// range, walked into model space there (parents come first), and its
// palette range gets each joint's bone times the joint's inverse bind.
// Mirrors ae_model::anim::{on_line, Rig::globals, Rig::palette}.
#define POSE
#include "units_common.glsl"
#include "units_models.glsl"

layout(local_size_x = 64) in;

mat3x4 rowsAt(uint i) { return mat3x4(anim[i], anim[i + 1u], anim[i + 2u]); }

// a * b, affine transforms as rows.
mat3x4 mul(mat3x4 a, mat3x4 b) {
    mat3x4 c;
    for (int i = 0; i < 3; i++) {
        c[i] = a[i].x * b[0] + a[i].y * b[1] + a[i].z * b[2] + vec4(0.0, 0.0, 0.0, a[i].w);
    }
    return c;
}

// Translation, rotation (unit quaternion xyzw), scale: T R S as rows.
mat3x4 trs(vec3 t, vec4 q, vec3 s) {
    vec3 q2 = q.xyz + q.xyz;
    float xx = q.x * q2.x, yy = q.y * q2.y, zz = q.z * q2.z;
    float xy = q.x * q2.y, xz = q.x * q2.z, yz = q.y * q2.z;
    float wx = q.w * q2.x, wy = q.w * q2.y, wz = q.w * q2.z;
    return mat3x4(
        vec4((1.0 - (yy + zz)) * s.x, (xy - wz) * s.y, (xz + wy) * s.z, t.x),
        vec4((xy + wz) * s.x, (1.0 - (xx + zz)) * s.y, (yz - wx) * s.z, t.y),
        vec4((xz - wy) * s.x, (yz + wx) * s.y, (1.0 - (xx + yy)) * s.z, t.z));
}

void main() {
    uint job = gl_GlobalInvocationID.x;
    if (job >= pc.cascade) {
        return;
    }
    uint cap = u.counts.y;
    uint row = rows[cap + job];
    uint scratch = rows[2u * cap + job];
    ModelClass mc = modelClasses[min(attru(ATTR_CLASS, row), MAX_CLASSES - 1u)];
    // Key k is keys[3k .. 3k + 2]; bone b's are 2b (older) and 2b + 1.
    uint first = 3u * attru(ATTR_POSE, row);
    float frac = uintBitsToFloat(u.anim.y);
    uint bones = mc.pose.y;
    for (uint k = 0u; k < bones; k++) {
        uint a = first + 6u * k;
        uint b = a + 3u;
        uint ta = floatBitsToUint(keys[a].w);
        int span = int(floatBitsToUint(keys[b].w) - ta);
        float s = span == 0 ? 1.0 : (float(int(u.anim.x - ta)) + frac) / float(span);
        vec4 q = normalize(mix(keys[a + 1u], keys[b + 1u], s));
        palette[scratch + k] = trs(mix(keys[a].xyz, keys[b].xyz, s), q, mix(keys[a + 2u].xyz, keys[b + 2u].xyz, s));
    }
    // Parents come before their children (roots have none).
    for (uint k = 0u; k < bones; k++) {
        uint parent = floatBitsToUint(anim[mc.pose.x + 4u * k + 3u].x);
        if (parent != 0xffffffffu) {
            palette[scratch + k] = mul(palette[scratch + parent], palette[scratch + k]);
        }
    }
    uint dst = poseOffset(row);
    for (uint k = 0u; k < mc.cmd.w; k++) {
        uint joint = mc.pose.z + 4u * k;
        palette[dst + k] = mul(palette[scratch + floatBitsToUint(anim[joint + 3u].x)], rowsAt(joint));
    }
}
