#version 460
// Copy this frame's spawn records from the host's upload into the graph's
// particle buffer (`water.particles`), which the splat and churn draws read.
#define WAVE_QUAL
#include "water_particle.glsl"

layout(local_size_x = 64) in;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= ae.words.z) return;
    waveSources[ae.words.y].entries[i] = waveSources[ae.words.x].entries[i];
}
