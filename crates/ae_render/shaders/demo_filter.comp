#version 450
// Demo compute chains: src -> dst with a selectable filter.
// mode 0: horizontal box blur, 1: vertical box blur, 2: invert,
// 3: grayscale tinted by the per-frame uploaded parameters.
//
// The images and the parameter block are global-set handles (M15 step E):
// push words x the mode, y and z the images' indices, w the block's.
#include "bindless.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(rgba8, set = AE_BINDLESS_SET, binding = AE_STORAGE_IMAGES) uniform image2D ae_storage_rgba8[];
layout(std140, set = AE_BINDLESS_SET, binding = AE_BUFFERS) readonly buffer Params {
    vec4 tint;
} ae_Params[];

#define src (ae_storage_rgba8[nonuniformEXT(ae.words.y)])
#define dst (ae_storage_rgba8[nonuniformEXT(ae.words.z)])
#define params (ae_Params[ae.words.w])

void main() {
    ivec2 size = imageSize(src);
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= size.x || p.y >= size.y) {
        return;
    }
    vec4 c = imageLoad(src, p);
    if (ae.words.x == 0u || ae.words.x == 1u) {
        ivec2 axis = ae.words.x == 0u ? ivec2(1, 0) : ivec2(0, 1);
        vec4 sum = vec4(0.0);
        for (int i = -4; i <= 4; ++i) {
            sum += imageLoad(src, clamp(p + axis * i, ivec2(0), size - 1));
        }
        c = sum / 9.0;
    } else if (ae.words.x == 2u) {
        c = vec4(1.0 - c.rgb, 1.0);
    } else {
        float g = dot(c.rgb, vec3(0.299, 0.587, 0.114));
        c = vec4(g * params.tint.rgb, 1.0);
    }
    imageStore(dst, p, c);
}
