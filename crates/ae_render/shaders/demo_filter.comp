#version 450
// Demo compute chains: src -> dst with a selectable filter.
// mode 0: horizontal box blur, 1: vertical box blur, 2: invert,
// 3: grayscale tinted by the per-frame uploaded parameters.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba8) uniform readonly image2D src;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D dst;
layout(set = 0, binding = 2) uniform Params { vec4 tint; } params;
layout(push_constant) uniform Push { int mode; } push;

void main() {
    ivec2 size = imageSize(src);
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= size.x || p.y >= size.y) {
        return;
    }
    vec4 c = imageLoad(src, p);
    if (push.mode == 0 || push.mode == 1) {
        ivec2 axis = push.mode == 0 ? ivec2(1, 0) : ivec2(0, 1);
        vec4 sum = vec4(0.0);
        for (int i = -4; i <= 4; ++i) {
            sum += imageLoad(src, clamp(p + axis * i, ivec2(0), size - 1));
        }
        c = sum / 9.0;
    } else if (push.mode == 2) {
        c = vec4(1.0 - c.rgb, 1.0);
    } else {
        float g = dot(c.rgb, vec3(0.299, 0.587, 0.114));
        c = vec4(g * params.tint.rgb, 1.0);
    }
    imageStore(dst, p, c);
}
