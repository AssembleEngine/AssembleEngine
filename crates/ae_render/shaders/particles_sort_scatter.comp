#version 460
// Radix sort pass 2: stable scatter to global offsets.
#include "particles_sort.glsl"

shared uint global_prefix_sums[RADIX_SORT_BINS];
shared uint global_offsets[RADIX_SORT_BINS];

struct BinFlags {
    uint flags[WORKGROUP_SIZE / 32];
};
shared BinFlags bin_flags[RADIX_SORT_BINS];

void main() {
    uint lID = gl_LocalInvocationID.x;
    uint wID = gl_WorkGroupID.x;
    uint n = cmd.instanceCount;
    uint groups = numWorkgroups();

    // This bin's exclusive prefix across workgroups, and its total.
    uint local_histogram = 0u;
    uint count = 0u;
    for (uint j = 0u; j < groups; j++) {
        uint t = histograms[RADIX_SORT_BINS * j + lID];
        local_histogram = (j == wID) ? count : local_histogram;
        count += t;
    }
    uint histogram_count = count;
    global_prefix_sums[lID] = histogram_count;
    barrier();
    for (uint offset = 1u; offset < RADIX_SORT_BINS; offset <<= 1) {
        uint t = (lID >= offset) ? global_prefix_sums[lID - offset] : 0u;
        barrier();
        global_prefix_sums[lID] += t;
        barrier();
    }
    global_offsets[lID] = global_prefix_sums[lID] - histogram_count + local_histogram;

    const uint flags_bin = lID / 32u;
    const uint flags_bit = 1u << (lID % 32u);
    for (uint index = 0u; index < BLOCKS_PER_WORKGROUP; index++) {
        // Uniform across the workgroup: no live keys from this block on.
        if ((wID * BLOCKS_PER_WORKGROUP + index) * WORKGROUP_SIZE >= n) {
            break;
        }
        uint elementId = wID * BLOCKS_PER_WORKGROUP * WORKGROUP_SIZE + index * WORKGROUP_SIZE + lID;
        for (int i = 0; i < WORKGROUP_SIZE / 32; i++) {
            bin_flags[lID].flags[i] = 0u;
        }
        barrier();
        uint key_in = 0u;
        uint binID = 0u;
        uint binOffset = 0u;
        if (elementId < n) {
            key_in = keyIn(elementId);
            binID = (key_in >> ae.shift) & uint(RADIX_SORT_BINS - 1);
            binOffset = global_offsets[binID];
            atomicAdd(bin_flags[binID].flags[flags_bin], flags_bit);
        }
        barrier();
        if (elementId < n) {
            // Rank among this block's lanes writing the same bin (stable).
            uint prefix = 0u;
            uint cnt = 0u;
            for (uint i = 0u; i < WORKGROUP_SIZE / 32; i++) {
                uint bits = bin_flags[binID].flags[i];
                uint full_count = bitCount(bits);
                uint partial_count = bitCount(bits & (flags_bit - 1u));
                prefix += (i < flags_bin) ? full_count : 0u;
                prefix += (i == flags_bin) ? partial_count : 0u;
                cnt += full_count;
            }
            keyOut(binOffset + prefix, key_in);
            if (prefix == cnt - 1u) {
                atomicAdd(global_offsets[binID], cnt);
            }
        }
        barrier();
    }
}
