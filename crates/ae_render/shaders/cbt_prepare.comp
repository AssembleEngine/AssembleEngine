#version 460
// mode 0: read the leaf count from the CBT root and size the update dispatch
//         (and reset the draw-list counter when this pass will build it).
// mode 1: clamp the draw-list counter to the draw-list capacity.
#include "terrain_common.glsl"

layout(local_size_x = 1) in;
// The bindless push block's words: x mode, y writeDraw, z level, w pad.

void main() {
    if (ae.words.x == 0u) {
        uint count = tree[1];
        ind[IND_LEAF_COUNT] = count;
        ind[0] = (count + 63u) / 64u;
        ind[1] = 1u;
        ind[2] = 1u;
        if (ae.words.y != 0u) ind[IND_DRAW_INSTANCES] = 0u;
#ifdef WATER_MESH
        ind[3] = 48u; // Sixteen triangles in each LEB leaf's submesh.
        ind[5] = 0u;
        ind[6] = 0u;
#elif defined(MIRROR)
        ind[3] = ae.words.y; // Index count of the sub-mesh.
        ind[5] = 0u;
        ind[6] = 0u;
        ind[7] = 0u;
#endif
    } else {
        ind[IND_DRAW_INSTANCES] = min(ind[IND_DRAW_INSTANCES], CBT_CAPACITY);
    }
}
