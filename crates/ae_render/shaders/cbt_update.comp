#version 460
// One thread per CBT leaf: emit the leaf into the (culled) draw list, then split or
// merge it according to its screen-space geometric error.
#include "terrain_common.glsl"

layout(local_size_x = 64) in;

#define MODE_SPLIT 0u
#define MODE_MERGE 1u
#define MODE_NONE 2u
// The bindless push block's words: x mode, y writeDraw, z level, w pad.

#ifdef WATER_MESH
#define WAVE_SAMPLE 14
#include "water_patch.glsl"
#include "water_lod_error.glsl"
#endif

#ifndef WATER_MESH
// The waterline's band (world units about the water level: the swell's
// reach) and its error gain: a vertical error at a steep bank moves the
// shoreline about twice as far sideways.
const float WATERLINE_MARGIN = 1.0;
const float WATERLINE_GAIN = 2.0;
// Below this height error (world units) the coarse mesh places the
// shoreline; above it, the spacing counts at this weight.
const float WATERLINE_FLAT = 0.25;
const float WATERLINE_SPACING = 0.5;
#endif

struct Bounds {
    vec3 bmin, bmax;
    float px;     // screen-space error of drawing this node with its sub-mesh
    bool inMap;
};

Bounds nodeBounds(ivec2 v0, ivec2 v1, ivec2 v2) {
    Bounds r;
    vec2 c0 = latticeToCell(v0), c1 = latticeToCell(v1), c2 = latticeToCell(v2);
    vec2 a = min(min(c0, c1), c2), b = max(max(c0, c1), c2);
#ifdef WATER_MESH
    vec2 extent = u.map.xy * u.map.w / u.map.z;
    vec2 p0 = c0 * extent, p1 = c1 * extent, p2 = c2 * extent;
    r.inMap = true;
    r.bmin = vec3(a.x * extent.x, u.water.x - WAVE_BOUND, a.y * extent.y);
    r.bmax = vec3(b.x * extent.x, u.water.x + WAVE_BOUND, b.y * extent.y);
    r.px = wavePixelError(p0, p1, p2, r.bmin, r.bmax);
#else
    r.inMap = a.x < u.map.x && a.y < u.map.y;
    float err = meshError(length(c1 - c0), c0, c1, c2, a, b, true);
    a = clamp(a, vec2(0.0), u.map.xy);
    b = clamp(b, vec2(0.0), u.map.xy);
    float hmin, hmax;
    boxHeights(a, b, hmin, hmax);
    r.bmin = cellToWorldBox(a, hmin);
    r.bmax = cellToWorldBox(b, hmax);
    r.px = projectError(err, r.bmin, r.bmax);
    // Where the node crosses the water level, a height error moves the
    // shoreline sideways by the error over the slope: seen from above it is
    // fully visible (a coarse channel shows its bed as triangles above the
    // water, and the water over its banks), so the sine discount does not
    // apply. Parents contain their children's boxes, so parents stay >=.
    if (u.water.y > 0.5 && hmin < u.water.x + WATERLINE_MARGIN && hmax > u.water.x - WATERLINE_MARGIN) {
        float dist = max(distance(clamp(u.lodCamPos.xyz, r.bmin, r.bmax), u.lodCamPos.xyz), 1.0);
        r.px = max(r.px, err * WATERLINE_GAIN * u.lod.y / dist);
        // From afar a channel narrower than the sub-mesh's spacing falls
        // between its vertices and vanishes (a few metres of height error,
        // a pixel, but the whole river's width): where the coarse mesh is
        // off at all, the shoreline may move by up to the spacing.
        if (err > WATERLINE_FLAT) {
            float spacing = length(c1 - c0) / float(SUBMESH_DENOM) * u.map.w;
            r.px = max(r.px, spacing * WATERLINE_SPACING * u.lod.y / dist);
        }
    }
#endif
    return r;
}

bool inFrustum(vec4 planes[6], vec3 bmin, vec3 bmax) {
    for (int i = 0; i < 6; ++i) {
        vec3 p = mix(bmin, bmax, greaterThan(planes[i].xyz, vec3(0.0)));
        if (dot(planes[i].xyz, p) + planes[i].w < 0.0) return false;
    }
    return true;
}

// Screen-space error in pixels (scaled down outside the view frustum, so that
// off-screen terrain stays coarser but not so coarse that it pops when it comes in).
float pixelError(Bounds r) {
    if (!r.inMap) return 0.0;
    return inFrustum(u.lodFrustum, r.bmin, r.bmax) ? r.px : r.px / u.lod.z;
}

float nodePixelError(uint id) {
    ivec2 v0, v1, v2;
    decodeTriangle(id, v0, v1, v2);
    return pixelError(nodeBounds(v0, v1, v2));
}

void main() {
    uint handle = gl_GlobalInvocationID.x;
    if (handle >= ind[IND_LEAF_COUNT]) return;

    uint id = decodeLeaf(handle);
    ivec2 v0, v1, v2;
    decodeTriangle(id, v0, v1, v2);
    Bounds r = nodeBounds(v0, v1, v2);

#ifdef MIRROR
    if (r.inMap && r.bmax.y >= u.water.x && inFrustum(u.mirrorPlanes, r.bmin, r.bmax)) {
#else
    if (ae.words.y != 0u && r.inMap && inFrustum(u.drawFrustum, r.bmin, r.bmax)) {
#endif
        uint slot = atomicAdd(ind[IND_DRAW_INSTANCES], 1u);
        if (slot < CBT_CAPACITY) leaves[slot] = Leaf(ivec4(v0, v1), ivec4(v2, int(id), 0));
    }

#ifndef MIRROR
    float tau = u.lod.x;
#ifdef WATER_MESH
    tau = 1.0;
#endif
    if (ae.words.x == MODE_SPLIT) {
        if (pixelError(r) > tau) splitConforming(id);
    } else if (ae.words.x == MODE_MERGE && depthOf(id) > 1u) {
        // Merge the whole diamond (parent + the parent's hypotenuse neighbour) when all
        // four children are leaves and neither parent would be split again.
        uint base = id >> 1;
        uint top = edgeNeighbor(base);
        if (top == 0u) top = base;
        if (isLeaf(id ^ 1u) && isLeaf(2u * top) && isLeaf(2u * top + 1u)) {
            float keep = tau * u.lod.w;
            if (nodePixelError(base) <= keep && (top == base || nodePixelError(top) <= keep)) {
                mergeNode(id);
                mergeNode(2u * top + 1u);
            }
        }
    }
#endif
}
