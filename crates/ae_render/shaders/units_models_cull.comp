#version 460
// units_cull.comp for a renderer with models: a unit of a class with a
// model is tested with its model's bounding sphere (with manual joints
// shown, the one covering any turn: models.rs turned_sphere) and appended to its
// class's region of the visible list, counted in each of the class's
// commands (one per primitive, classCommands); the others as darts.
// With the units' shadow map on, a model unit is also tested against each
// cascade and appended to the class's region for that cascade, counted in
// that cascade's copy of the commands (the shadow caster draws those).
// Only the cascade's sides are tested, not its depth: a caster nearer the
// sun than the cascade's box still shadows what is in it (and past the
// box's depth the rasterizer clips it, as without the cull).
#define CULL
#define MODELS
#include "units_common.glsl"
#include "units_models.glsl"
#include "units_dart.glsl"

layout(local_size_x = 64) in;

bool inView(vec3 centre, float r) {
    for (int k = 0; k < 6; k++) {
        if (dot(u.frustum[k].xyz, centre) + u.frustum[k].w < -r) {
            return false;
        }
    }
    return true;
}

// The instance count of model command k.
uint countWord(uint k) { return 4u + 5u * k + 1u; }

// Unit i into its class's region of list l (0: the camera's, k + 1:
// cascade k's), counted in each of the class's commands of that list.
void append(uint i, ModelClass mc, uint l) {
    uint shift = l * u.counts.w;
    uint first = classCommands[mc.cmd.x];
    uint slot = atomicAdd(cmdWords[countWord(first + shift)], 1u);
    for (uint k = 1u; k < mc.cmd.y; k++) {
        atomicAdd(cmdWords[countWord(classCommands[mc.cmd.x + k] + shift)], 1u);
    }
    visible[draws[first].visibleBase + l * u.counts.y + slot] = i;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= u.counts.x) {
        return;
    }
    Unit unit = loadUnit(i);
    ModelClass mc = modelClasses[unit.cls];
    if (mc.cmd.y == 0u) {
        if (inView(unit.pos + vec3(0.0, 0.4 * unit.size, 0.0), 1.6 * unit.size)) {
            visible[atomicAdd(cmdWords[1], 1u)] = i;
        }
        return;
    }
    // Manual joints can reach past the clips' sphere: a unit with any
    // shown (in either record) takes the sphere covering any turn.
    vec4 sphere = mc.sphere;
    uint rec = attru(ATTR_POSE, i);
    if (mc.fit.y > 0.0 && rec != 0xffffffffu && rec + 2u * RECORD_CELLS <= 2u * RECORD_CELLS * u.counts.y
        && max(records[rec].y, records[rec + RECORD_CELLS].y) > 0u) {
        sphere = vec4(mc.sphere.xyz * mc.fit.z, mc.fit.y);
    }
    vec3 centre = place(unit, sphere.xyz);
    float r = sphere.w * unit.size;
    if (inView(centre, r)) {
        append(i, mc, 0u);
    }
    if (u.unitShadowScale[0].w > 0.0) {
        vec2 l = vec2(dot(u.unitShadowAxes[0].xyz, centre), dot(u.unitShadowAxes[1].xyz, centre));
        for (uint k = 0u; k < uint(UNIT_CASCADES); k++) {
            vec2 scale = u.unitShadowScale[k].xy;
            if (all(lessThanEqual(abs(l - u.unitShadowOrigin[k].xy) * scale, vec2(1.0) + r * scale))) {
                append(i, mc, k + 1u);
            }
        }
    }
}
