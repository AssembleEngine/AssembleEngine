+/* ecs_sim patch: component column storage allocator.
+ * Table column arrays (ecs_column_t.data) are allocated through these hooks
+ * instead of ecs_os_malloc/realloc/free so an embedder can place component data
+ * in memory shared with a sandboxed guest, while all other Flecs allocations
+ * (world, tables, queries, entity arrays) stay on the host heap. When no
+ * allocator is set the hooks fall back to ecs_os_*. */
+typedef struct ecs_column_allocator_t {
+    void* (*malloc_)(ecs_size_t size);
+    void* (*realloc_)(void *ptr, ecs_size_t size);
+    void (*free_)(void *ptr);
+} ecs_column_allocator_t;
+
+FLECS_API void ecs_column_allocator_set(const ecs_column_allocator_t *allocator);
+FLECS_API void* ecs_column_malloc(ecs_size_t size);
+FLECS_API void* ecs_column_realloc(void *ptr, ecs_size_t size);
+FLECS_API void ecs_column_free(void *ptr);
+
