+/* ecs_sim patch: column storage allocator (see flecs.h). */
+static ecs_column_allocator_t ecs_column_alloc_api;
+
+void ecs_column_allocator_set(const ecs_column_allocator_t *allocator) {
+    if (allocator) {
+        ecs_column_alloc_api = *allocator;
+    } else {
+        ecs_os_zeromem(&ecs_column_alloc_api);
+    }
+}
+
+void* ecs_column_malloc(ecs_size_t size) {
+    return ecs_column_alloc_api.malloc_
+        ? ecs_column_alloc_api.malloc_(size) : ecs_os_malloc(size);
+}
+
+void* ecs_column_realloc(void *ptr, ecs_size_t size) {
+    return ecs_column_alloc_api.realloc_
+        ? ecs_column_alloc_api.realloc_(ptr, size) : ecs_os_realloc(ptr, size);
+}
+
+void ecs_column_free(void *ptr) {
+    if (ecs_column_alloc_api.free_) {
+        ecs_column_alloc_api.free_(ptr);
+    } else {
+        ecs_os_free(ptr);
+    }
+}
