#!/bin/sh
# Pre-commit gate: refuse a commit that the formatter or clippy rejects.
#
#   git config core.hooksPath .githooks     # once per clone (ae-tool hooks install)
#
# The gate is local, not a security boundary: `git commit --no-verify` skips it
# (git's own escape hatch, for a work-in-progress commit; re-run it through the
# hook before it is shared). There is no skip environment variable and the hook
# never edits the index or the working tree.
#
# What fires:
# - any staged `.rs` file: the formatter check over the workspace and the guest
#   crates (`tools/fmt.sh --check`, which also covers the guest manifests that
#   `cargo fmt --all` cannot reach);
# - any staged `.rs`, `Cargo.toml`, `Cargo.lock`, `build.rs`, `.cargo/` or the
#   format configuration itself (`rustfmt.toml`, `rust-toolchain.toml`):
#   `cargo clippy --workspace --all-targets -- -D warnings`.
#   So a docs-only commit returns at once, and a code commit pays for clippy.
#
# The checks read the working tree, not the index: with a partially staged file,
# stage everything (`git add -A`) first.
set -u

cd "$(git rev-parse --show-toplevel)" || exit 1

format=no
lint=no
while IFS= read -r path; do
    [ -n "$path" ] || continue
    case "$path" in
        *.rs | rustfmt.toml | rust-toolchain.toml)
            format=yes
            lint=yes
            ;;
        Cargo.toml | */Cargo.toml | Cargo.lock | build.rs | */build.rs | .cargo/* | */.cargo/*)
            lint=yes
            ;;
    esac
done <<EOF
$(git diff --cached --name-only --diff-filter=ACMR)
EOF

if [ "$format" = no ] && [ "$lint" = no ]; then
    exit 0
fi

if [ "$format" = yes ]; then
    output=$(tools/fmt.sh --check 2>&1) || {
        files=$(printf '%s\n' "$output" | sed -n 's/^Diff in \(.*\):[0-9][0-9]*:$/  \1/p' | sort -u)
        echo "pre-commit: the formatter rejects these files:" >&2
        if [ -n "$files" ]; then
            printf '%s\n' "$files" >&2
        else
            printf '%s\n' "$output" >&2
        fi
        echo "pre-commit: fix them with \`cargo fmt --all\` and \`tools/fmt.sh\` (the guests)," >&2
        echo "pre-commit: or \`tools/fmt.sh\` alone, which does both; then stage the result." >&2
        exit 1
    }
fi

if [ "$lint" = yes ]; then
    start=$(date +%s)
    output=$(cargo clippy --workspace --all-targets -- -D warnings 2>&1) || {
        echo "pre-commit: clippy rejects this commit (the first diagnostics):" >&2
        printf '%s\n' "$output" | head -n 60 >&2
        echo "..." >&2
        echo "pre-commit: run \`cargo clippy --workspace --all-targets -- -D warnings\` for all of them." >&2
        echo "pre-commit: a fix must not change bits; a float suggestion that would (FMA, exact" >&2
        echo "pre-commit: constants) gets a scoped #[allow(clippy::...)] with the reason instead." >&2
        exit 1
    }
    echo "pre-commit: clippy clean in $(( $(date +%s) - start )) s" >&2
fi

exit 0
