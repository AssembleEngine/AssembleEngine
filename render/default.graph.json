{
  "version": 1,
  "resources": [
    { "name": "terrain.leaves", "kind": "library" },
    { "name": "terrain.indirect", "kind": "library" },
    { "name": "depth", "kind": "image", "format": "D32_SFLOAT", "usage": ["depth_stencil_attachment", "sampled"] },
    { "name": "target", "kind": "output" },
    { "name": "scene", "kind": "image", "format": "scene", "usage": ["color_attachment", "sampled"] },
    { "name": "display", "kind": "image", "format": "display", "usage": ["color_attachment", "sampled"], "when": "hdr" },
    { "name": "glow", "kind": "image", "format": "glow", "usage": ["color_attachment", "sampled"] },
    { "name": "bloom.0", "kind": "image", "format": "bloom", "usage": ["color_attachment", "sampled"], "scale": 0.25 },
    { "name": "bloom.1", "kind": "image", "format": "bloom", "usage": ["color_attachment", "sampled"], "scale": 0.25 },
    { "name": "units.instances", "kind": "library", "when": "units" },
    { "name": "units.visible", "kind": "library", "when": "units" },
    { "name": "units.indirect", "kind": "library", "when": "units" },
    { "name": "units.counts", "kind": "library", "when": "units" },
    { "name": "units.palette", "kind": "library", "when": "units" },
    { "name": "shadows.map", "kind": "library", "when": "shadows" },
    { "name": "particles.state", "kind": "library", "when": "particles" },
    { "name": "particles.keys", "kind": "library", "when": "particles" },
    { "name": "particles.indirect", "kind": "library", "when": "particles" },
    { "name": "shadows.color", "kind": "library", "when": "particle_shadows" },
    { "name": "lights.list", "kind": "library" },
    { "name": "lights.clusters", "kind": "library" },
    { "name": "exposure", "kind": "library" },
    { "name": "exposure.histogram", "kind": "library" },
    { "name": "water.reflection", "kind": "image", "format": "scene", "usage": ["color_attachment", "sampled", "transfer_src"], "scale": 0.5, "when": "water_reflect" },
    { "name": "water.reflection.depth", "kind": "image", "format": "D32_SFLOAT", "usage": ["depth_stencil_attachment"], "scale": 0.5, "when": "water_reflect" },
    { "name": "terrain.leaves_reflect", "kind": "library", "when": "water_reflect" },
    { "name": "terrain.indirect_reflect", "kind": "library", "when": "water_reflect" },
    { "name": "units.visible_reflect", "kind": "library", "when": "water_reflect_units" },
    { "name": "units.indirect_reflect", "kind": "library", "when": "water_reflect_units" },
    { "name": "water.refraction", "kind": "image", "format": "scene", "usage": ["color_attachment", "sampled", "transfer_src"], "when": "water_refract" },
    { "name": "water.caustics", "kind": "library", "when": "water_refract" },
    { "name": "water.volume.out", "kind": "image", "format": "scene", "usage": ["color_attachment", "sampled", "transfer_src"], "when": "water_volume" },
    { "name": "water.raw", "kind": "library", "when": "water_waves" },
    { "name": "water.churn", "kind": "library", "when": "water_waves" },
    { "name": "water.waves", "kind": "library", "when": "water_waves" },
    { "name": "water.particles", "kind": "library", "when": "water_waves" },
    { "name": "water.mesh.leaves", "kind": "library", "when": "water_waves" },
    { "name": "water.mesh.indirect", "kind": "library", "when": "water_waves" },
    { "name": "water.shore", "kind": "library", "when": "water_waves" }
  ],
  "passes": [
    { "name": "water emit", "kind": "compute", "library": "water.emit", "when": "water_waves",
      "access": ["water.particles storage_buffer_write:compute discard"] },
    { "name": "water splat", "kind": "graphics", "library": "water.splat", "when": "water_waves",
      "access": ["water.particles storage_buffer_read:vertex", "water.raw color:clear"] },
    { "name": "water churn", "kind": "graphics", "library": "water.churn", "when": "water_waves",
      "access": ["water.particles storage_buffer_read:vertex", "water.churn color:clear"] },
    { "name": "water blur", "kind": "compute", "library": "water.blur", "when": "water_waves",
      "access": ["water.raw sampled:compute", "water.churn sampled:compute", "water.waves storage_image_write:compute discard"] },
    { "name": "water lod", "kind": "compute", "library": "water.lod", "when": "water_waves",
      "access": ["water.waves sampled:compute", "water.mesh.leaves storage_buffer_write:compute discard", "water.mesh.indirect storage_buffer_write:compute discard"] },
    { "name": "shore bake", "kind": "compute", "library": "water.shore", "when": "water_waves", "root": true,
      "access": ["water.shore storage_image_write:compute"] },
    { "name": "terrain lod", "kind": "compute", "library": "terrain.lod",
      "access": ["terrain.leaves storage_buffer_write:compute", "terrain.indirect storage_buffer_write:compute"] },
    { "name": "units pose", "kind": "compute", "library": "units.pose", "when": "units",
      "access": ["units.instances storage_buffer_read:compute", "units.palette storage_buffer_write:compute"] },
    { "name": "units reset", "kind": "transfer", "library": "units.reset", "when": "units",
      "access": ["units.indirect transfer_dst"] },
    { "name": "units reset reflect", "kind": "transfer", "library": "units.reset_reflect", "when": "water_reflect_units",
      "access": ["units.indirect_reflect transfer_dst discard"] },
    { "name": "units cull", "kind": "compute", "library": "units.cull", "when": "units",
      "access": ["units.instances storage_buffer_read:compute", "units.visible storage_buffer_write:compute", "units.indirect storage_buffer_write:compute", "units.visible_reflect storage_buffer_write:compute discard", "units.indirect_reflect storage_buffer_write:compute"] },
    { "name": "lights", "kind": "compute", "library": "lights.cluster",
      "access": ["lights.list storage_buffer_write:compute", "lights.clusters storage_buffer_write:compute"] },
    { "name": "shadow pages", "kind": "compute", "library": "shadows.prepare", "when": "shadows",
      "access": ["units.instances storage_buffer_read:compute", "units.visible storage_buffer_read_write:compute", "units.indirect storage_buffer_read_write:compute", "shadows.map storage_image_read_write:compute"] },
    { "name": "shadows", "kind": "graphics", "library": "shadows.draw", "when": "shadows",
      "access": ["units.instances storage_buffer_read:vertex", "units.visible storage_buffer_read:vertex", "units.indirect indirect", "units.palette storage_buffer_read:vertex", "water.waves sampled:vertex", "shadows.map storage_image_read_write:fragment"] },
    { "name": "particle shadows", "kind": "graphics", "library": "shadows.particles", "when": "particle_shadows",
      "access": ["particles.state storage_buffer_read:vertex", "particles.keys storage_buffer_read:vertex", "particles.indirect indirect", "shadows.color color:clear"] },
    { "name": "terrain cull reflect", "kind": "compute", "library": "terrain.cull_reflect", "when": "water_reflect",
      "access": ["terrain.indirect storage_buffer_read:compute", "terrain.leaves_reflect storage_buffer_write:compute discard", "terrain.indirect_reflect storage_buffer_write:compute discard"] },
    { "name": "terrain reflect", "kind": "graphics", "library": "terrain.reflect", "when": "water_reflect",
      "access": ["terrain.leaves_reflect storage_buffer_read:vertex", "terrain.indirect_reflect indirect", "water.reflection color:clear", "water.reflection.depth depth:clear", "shadows.map sampled:fragment", "shadows.color sampled:fragment"] },
    { "name": "units reflect", "kind": "graphics", "library": "units.reflect", "when": "water_reflect_units",
      "access": ["units.instances storage_buffer_read:vertex", "units.visible_reflect storage_buffer_read:vertex", "units.indirect_reflect indirect", "units.palette storage_buffer_read:vertex", "water.waves sampled:vertex", "water.reflection color:load", "water.reflection.depth depth:load", "shadows.map sampled:fragment", "shadows.color sampled:fragment"] },
    { "name": "terrain", "kind": "graphics", "library": "terrain.draw",
      "access": ["terrain.leaves storage_buffer_read:vertex", "terrain.indirect indirect", "scene color:clear", "glow color:clear", "depth depth:clear", "shadows.map sampled:fragment", "shadows.color sampled:fragment", "lights.list storage_buffer_read:fragment", "lights.clusters storage_buffer_read:fragment"] },
    { "name": "units", "kind": "graphics", "library": "units.draw", "when": "units",
      "access": ["units.instances storage_buffer_read:vertex", "units.visible storage_buffer_read:vertex", "units.indirect indirect", "units.palette storage_buffer_read:vertex", "scene color:load", "glow color:load", "depth depth:load", "water.waves sampled:vertex", "shadows.map sampled:fragment", "shadows.color sampled:fragment", "lights.list storage_buffer_read:fragment", "lights.clusters storage_buffer_read:fragment"] },
    { "name": "units count", "kind": "transfer", "library": "units.count", "when": "units",
      "access": ["units.indirect transfer_src", "units.counts transfer_dst discard"] },
    { "name": "units count read", "kind": "transfer", "library": "host.read", "when": "units", "root": true,
      "access": ["units.counts host_read"] },
    { "name": "particles sim", "kind": "compute", "library": "particles.sim", "when": "particles_refract",
      "access": ["particles.state storage_buffer_write:compute", "particles.keys storage_buffer_write:compute", "particles.indirect storage_buffer_write:compute", "water.waves sampled:compute", "lights.list storage_buffer_read:compute", "lights.clusters storage_buffer_read:compute"] },
    { "name": "water underwater", "kind": "graphics", "library": "water.underwater", "when": "water_refract",
      "access": ["water.refraction color:clear", "scene sampled:fragment", "depth sampled:fragment", "water.caustics sampled:fragment", "shadows.map sampled:fragment", "shadows.color sampled:fragment", "water.waves sampled:fragment"] },
    { "name": "particles underwater", "kind": "graphics", "library": "particles.underwater", "when": "particles_water_split",
      "access": ["particles.state storage_buffer_read:vertex", "particles.keys storage_buffer_read:vertex", "particles.indirect indirect", "water.refraction color:load", "depth sampled:fragment", "water.waves sampled:fragment"] },
    { "name": "water", "kind": "graphics", "library": "water.draw", "when": "water",
      "access": ["scene color:load", "glow color:load", "depth depth_read", "water.reflection sampled:fragment", "water.refraction sampled:fragment", "water.waves sampled:graphics", "water.mesh.leaves storage_buffer_read:vertex", "water.mesh.indirect indirect", "water.churn sampled:fragment", "water.shore sampled:fragment", "shadows.map sampled:fragment", "shadows.color sampled:fragment", "lights.list storage_buffer_read:fragment", "lights.clusters storage_buffer_read:fragment"] },
    { "name": "units water overlay", "kind": "graphics", "library": "units.water_overlay", "when": "water_refract_units",
      "access": ["units.instances storage_buffer_read:vertex", "units.visible storage_buffer_read:vertex", "units.indirect indirect", "units.palette storage_buffer_read:vertex", "scene color:load", "glow color:load", "depth depth:load", "shadows.map sampled:fragment", "shadows.color sampled:fragment", "lights.list storage_buffer_read:fragment", "lights.clusters storage_buffer_read:fragment"] },
    { "name": "particles sim", "kind": "compute", "library": "particles.sim", "when": "particles_no_refract",
      "access": ["particles.state storage_buffer_write:compute", "particles.keys storage_buffer_write:compute", "particles.indirect storage_buffer_write:compute", "lights.list storage_buffer_read:compute", "lights.clusters storage_buffer_read:compute"] },
    { "name": "particles", "kind": "graphics", "library": "particles.draw", "when": "particles",
      "access": ["particles.state storage_buffer_read:vertex", "particles.keys storage_buffer_read:vertex", "particles.indirect indirect", "scene color:load", "glow color:load", "depth sampled:fragment"] },
    { "name": "water volume", "kind": "graphics", "library": "water.volume", "when": "water_volume",
      "access": ["scene sampled:fragment", "depth sampled:fragment", "water.refraction sampled:fragment", "water.waves sampled:fragment", "water.volume.out color:dont_care"] },
    { "name": "exposure clear", "kind": "transfer", "library": "exposure.clear",
      "access": ["exposure.histogram transfer_dst"] },
    { "name": "exposure meter", "kind": "compute", "library": "exposure.meter",
      "access": ["water.volume.out|scene sampled:compute", "depth sampled:compute", "glow sampled:compute", "exposure.histogram storage_buffer_read_write:compute"] },
    { "name": "exposure adapt", "kind": "compute", "library": "exposure.adapt",
      "access": ["exposure.histogram storage_buffer_read:compute", "exposure storage_image_read_write:compute"] },
    { "name": "bloom downsample", "kind": "graphics", "library": "bloom.downsample",
      "access": ["glow sampled:fragment", "exposure sampled:fragment", "bloom.0 color:dont_care"] },
    { "name": "bloom blur x", "kind": "graphics", "library": "bloom.blur_x",
      "access": ["bloom.0 sampled:fragment", "bloom.1 color:dont_care"] },
    { "name": "bloom blur y", "kind": "graphics", "library": "bloom.blur_y",
      "access": ["bloom.1 sampled:fragment", "bloom.0 color:dont_care"] },
    { "name": "tonemap", "kind": "graphics", "library": "post.tonemap", "when": "hdr",
      "access": ["water.volume.out|scene sampled:fragment", "bloom.0 sampled:fragment", "exposure sampled:fragment", "display color:dont_care"] },
    { "name": "tonemap", "kind": "graphics", "library": "post.tonemap", "when": "sdr",
      "access": ["water.volume.out|scene sampled:fragment", "bloom.0 sampled:fragment", "exposure sampled:fragment", "target color:dont_care"] },
    { "name": "encode", "kind": "graphics", "library": "post.encode", "when": "hdr",
      "access": ["display sampled:fragment", "target color:dont_care"] }
  ]
}
