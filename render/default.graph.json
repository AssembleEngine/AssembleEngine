{
  "version": 1,
  "resources": [
    { "name": "terrain.leaves", "kind": "library" },
    { "name": "terrain.indirect", "kind": "library" },
    { "name": "depth", "kind": "image", "format": "D32_SFLOAT", "usage": ["depth_stencil_attachment", "sampled"] },
    { "name": "target", "kind": "output" },
    { "name": "scene", "kind": "image", "format": "scene", "usage": ["color_attachment", "sampled"] },
    { "name": "display", "kind": "image", "format": "display", "usage": ["color_attachment", "sampled"], "when": "hdr" },
    { "name": "glow", "kind": "image", "format": "glow", "usage": ["color_attachment", "sampled"] },
    { "name": "bloom.0", "kind": "image", "format": "bloom", "usage": ["color_attachment", "sampled"], "scale": 0.25 },
    { "name": "bloom.1", "kind": "image", "format": "bloom", "usage": ["color_attachment", "sampled"], "scale": 0.25 },
    { "name": "units.instances", "kind": "library", "when": "units" },
    { "name": "units.visible", "kind": "library", "when": "units" },
    { "name": "units.indirect", "kind": "library", "when": "units" },
    { "name": "units.counts", "kind": "library", "when": "units" },
    { "name": "units.palette", "kind": "library", "when": "units" },
    { "name": "shadows.map", "kind": "library", "when": "shadows" },
    { "name": "particles.state", "kind": "library", "when": "particles" },
    { "name": "particles.keys", "kind": "library", "when": "particles" },
    { "name": "particles.indirect", "kind": "library", "when": "particles" },
    { "name": "shadows.color", "kind": "library", "when": "particle_shadows" },
    { "name": "lights.list", "kind": "library" },
    { "name": "lights.clusters", "kind": "library" },
    { "name": "exposure", "kind": "library" },
    { "name": "exposure.histogram", "kind": "library" }
  ],
  "passes": [
    { "name": "terrain lod", "kind": "compute", "library": "terrain.lod",
      "access": ["terrain.leaves storage_buffer_write:compute", "terrain.indirect storage_buffer_write:compute"] },
    { "name": "units pose", "kind": "compute", "library": "units.pose", "when": "units",
      "access": ["units.instances storage_buffer_read:compute", "units.palette storage_buffer_write:compute"] },
    { "name": "units reset", "kind": "transfer", "library": "units.reset", "when": "units",
      "access": ["units.indirect transfer_dst"] },
    { "name": "units cull", "kind": "compute", "library": "units.cull", "when": "units",
      "access": ["units.instances storage_buffer_read:compute", "units.visible storage_buffer_write:compute", "units.indirect storage_buffer_write:compute"] },
    { "name": "lights", "kind": "compute", "library": "lights.cluster",
      "access": ["lights.list storage_buffer_write:compute", "lights.clusters storage_buffer_write:compute"] },
    { "name": "shadows", "kind": "graphics", "library": "shadows.draw", "when": "shadows",
      "access": ["units.instances storage_buffer_read:vertex", "units.visible storage_buffer_read:vertex", "units.indirect indirect", "units.palette storage_buffer_read:vertex", "shadows.map depth:clear"] },
    { "name": "particle shadows", "kind": "graphics", "library": "shadows.particles", "when": "particle_shadows",
      "access": ["particles.state storage_buffer_read:vertex", "particles.keys storage_buffer_read:vertex", "particles.indirect indirect", "shadows.color color:clear"] },
    { "name": "terrain", "kind": "graphics", "library": "terrain.draw",
      "access": ["terrain.leaves storage_buffer_read:vertex", "terrain.indirect indirect", "scene color:clear", "glow color:clear", "depth depth:clear", "shadows.map sampled:fragment", "shadows.color sampled:fragment", "lights.list storage_buffer_read:fragment", "lights.clusters storage_buffer_read:fragment"] },
    { "name": "units", "kind": "graphics", "library": "units.draw", "when": "units",
      "access": ["units.instances storage_buffer_read:vertex", "units.visible storage_buffer_read:vertex", "units.indirect indirect", "units.palette storage_buffer_read:vertex", "scene color:load", "glow color:load", "depth depth:load", "shadows.map sampled:fragment", "shadows.color sampled:fragment", "lights.list storage_buffer_read:fragment", "lights.clusters storage_buffer_read:fragment"] },
    { "name": "units count", "kind": "transfer", "library": "units.count", "when": "units",
      "access": ["units.indirect transfer_src", "units.counts transfer_dst discard"] },
    { "name": "units count read", "kind": "transfer", "library": "host.read", "when": "units", "root": true,
      "access": ["units.counts host_read"] },
    { "name": "water", "kind": "graphics", "library": "water.draw", "when": "water",
      "access": ["scene color:load", "glow color:load", "depth depth_read", "shadows.map sampled:fragment", "shadows.color sampled:fragment", "lights.list storage_buffer_read:fragment", "lights.clusters storage_buffer_read:fragment"] },
    { "name": "particles sim", "kind": "compute", "library": "particles.sim", "when": "particles",
      "access": ["particles.state storage_buffer_write:compute", "particles.keys storage_buffer_write:compute", "particles.indirect storage_buffer_write:compute", "lights.list storage_buffer_read:compute", "lights.clusters storage_buffer_read:compute"] },
    { "name": "particles", "kind": "graphics", "library": "particles.draw", "when": "particles",
      "access": ["particles.state storage_buffer_read:vertex", "particles.keys storage_buffer_read:vertex", "particles.indirect indirect", "scene color:load", "glow color:load", "depth sampled:fragment"] },
    { "name": "exposure clear", "kind": "transfer", "library": "exposure.clear",
      "access": ["exposure.histogram transfer_dst"] },
    { "name": "exposure meter", "kind": "compute", "library": "exposure.meter",
      "access": ["scene sampled:compute", "depth sampled:compute", "glow sampled:compute", "exposure.histogram storage_buffer_read_write:compute"] },
    { "name": "exposure adapt", "kind": "compute", "library": "exposure.adapt",
      "access": ["exposure.histogram storage_buffer_read:compute", "exposure storage_image_read_write:compute"] },
    { "name": "bloom downsample", "kind": "graphics", "library": "bloom.downsample",
      "access": ["glow sampled:fragment", "exposure sampled:fragment", "bloom.0 color:dont_care"] },
    { "name": "bloom blur x", "kind": "graphics", "library": "bloom.blur_x",
      "access": ["bloom.0 sampled:fragment", "bloom.1 color:dont_care"] },
    { "name": "bloom blur y", "kind": "graphics", "library": "bloom.blur_y",
      "access": ["bloom.1 sampled:fragment", "bloom.0 color:dont_care"] },
    { "name": "tonemap", "kind": "graphics", "library": "post.tonemap", "when": "hdr",
      "access": ["scene sampled:fragment", "bloom.0 sampled:fragment", "exposure sampled:fragment", "display color:dont_care"] },
    { "name": "tonemap", "kind": "graphics", "library": "post.tonemap", "when": "sdr",
      "access": ["scene sampled:fragment", "bloom.0 sampled:fragment", "exposure sampled:fragment", "target color:dont_care"] },
    { "name": "encode", "kind": "graphics", "library": "post.encode", "when": "hdr",
      "access": ["display sampled:fragment", "target color:dont_care"] }
  ]
}
